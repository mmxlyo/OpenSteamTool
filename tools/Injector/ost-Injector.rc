#include <windows.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenSteamTool"
            VALUE "FileDescription",  "OpenSteamTool Portable Helper and Auto Injector"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ost-Injector.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2024-2026 OpenSteamTool"
            VALUE "OriginalFilename", "ost-Injector.exe"
            VALUE "ProductName",      "OpenSteamTool"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
